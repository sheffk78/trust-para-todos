---
export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  /** Per-page OG image filename (e.g., "og-home.png"). If omitted, falls back to default og-image.png */
  ogImage?: string;
  /** Optional JSON-LD structured data objects to inject into the page */
  jsonLd?: object[] | object;
}

const { title, description, canonicalPath, ogImage, jsonLd } = Astro.props;

const SITE_URL = 'https://trustparatodos.com';
const OG_IMAGE = `${SITE_URL}/${ogImage ?? 'og-image.png'}`;

// Determine canonical URL — use provided path or fall back to current URL path
const path = canonicalPath ?? Astro.url.pathname;
// Ensure trailing slash on canonical URL (matching trailingSlash: 'always' config)
const normalizedPath = path === '/' ? path : (path.endsWith('/') ? path : path + '/');
const canonicalURL = new URL(normalizedPath, SITE_URL).href;

const ogType = path === '/' ? 'website' : 'article';

// Organization JSON-LD — present on all pages
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Trust Para Todos',
  url: SITE_URL,
  logo: `${SITE_URL}/assets/logo-shield.svg`,
  description: 'Plataforma de protección patrimonial con trusts para familias mexicanas en Estados Unidos.',
  sameAs: [
    'https://trustoffice.app',
    'https://wingpointtrust.com'
  ]
};

// Collect all JSON-LD objects
const allSchemas = [orgSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    allSchemas.push(...jsonLd);
  } else {
    allSchemas.push(jsonLd);
  }
}

import '../styles/fonts.css';
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Trust Para Todos</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/assets/logo-shield.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph tags -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Trust Para Todos" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />

    <!-- hreflang tags — Spanish is canonical, English available via cookie toggle -->
    <link rel="alternate" hreflang="es" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <!-- JSON-LD Structured Data -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Resource hints for faster loading -->
    <link rel="preconnect" href="https://plausible.io" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <!-- Plausible Analytics -->
    <script defer data-domain="trustparatodos.com" src="https://plausible.io/js/script.js"></script>

    <!-- Google Analytics (GA4) -->
    <script is:inline src="https://www.googletagmanager.com/gtag/js?id=G-0B8J8P20DC" async></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0B8J8P20DC');
    </script>
  </head>
  <body>
    <div class="noise-overlay"></div>

    <!-- #2: Skip-to-content link (CRITICAL) -->
    <a href="#main-content" class="skip-to-content">Saltar al contenido</a>

    <!-- #8: Scroll progress bar (POLISH) -->
    <div class="scroll-progress" id="scroll-progress"></div>

    <header class="header">
      <nav class="nav">
        <a href="/" class="logo">
          <span class="logo-icon">
            <img src="/assets/logo-shield.svg" alt="Trust Para Todos" width="28" height="28" />
          </span>
          <span class="logo-text">Trust Para Todos</span>
        </a>
        <div class="nav-links">
          <a href="/que-es/">¿Qué es?</a>
          <a href="/como-funciona/">Cómo funciona</a>
          <a href="/blog/">Blog</a>
          <a href="/preguntas-frecuentes/">FAQ</a>
          <a href="/evaluacion/" class="btn btn-primary btn-sm">Tu evaluación</a>
          <div class="nav-search">
            <button class="nav-search-btn" id="nav-search-btn" aria-label="Buscar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            </button>
            <div class="nav-search-dropdown" id="nav-search-dropdown" style="display:none;">
              <input type="search" id="nav-search-input" placeholder="Buscar en el sitio..." aria-label="Buscar" />
              <div class="nav-search-results" id="nav-search-results"></div>
            </div>
          </div>
          <button class="theme-toggle" id="theme-toggle" aria-label="Cambiar tema" title="Cambiar tema">
            <svg class="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <svg class="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          </button>
          <div class="lang-toggle">
            <a href="#" data-lang="es" class="lang-link active">ES</a>
            <span class="lang-sep">|</span>
            <a href="#" data-lang="en" class="lang-link">EN</a>
          </div>
        </div>
        <button class="mobile-menu-btn" aria-label="Menú">☰</button>
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-grid">
        <div>
          <div class="footer-brand">Trust Para Todos</div>
          <p>Protege a tu familia. Asegura tu legado.</p>
          <p class="footer-powered">Powered by <a href="https://trustoffice.app">TrustOffice</a></p>
        </div>
        <div>
          <h4>Enlaces</h4>
          <a href="/que-es/">¿Qué es un trust?</a>
          <a href="/como-funciona/">Cómo funciona</a>
          <a href="/blog/">Blog</a>
          <a href="/preguntas-frecuentes/">Preguntas frecuentes</a>
          <a href="/contacto/">Contacto</a>
        </div>
        <div>
          <h4>Recursos</h4>
          <a href="/testimonios/">Testimonios</a>
          <a href="/asociaciones/">Asociaciones</a>
          <a href="/legal/">Aviso legal</a>
        </div>
        <div>
          <h4>Contacto</h4>
          <!-- TODO: Replace with real WhatsApp number -->
          <a href="https://wa.me/18001234567" class="whatsapp-link">WhatsApp: ¡Escríbenos!</a>
          <a href="/contacto/">Formulario de contacto</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 Trust Para Todos. Todos los derechos reservados.</p>
        <p class="footer-disclaimer">Trust Para Todos proporciona documentos legales preparados por abogados. No somos un bufete de abogados. Este sitio no proporciona asesoramiento legal.</p>
      </div>
    </footer>

    <!-- #4: Back-to-top button (POLISH) -->
    <button class="back-to-top" id="back-to-top" aria-label="Volver arriba" title="Volver arriba">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"></polyline></svg>
    </button>

    <!-- #20: Floating contact/WhatsApp button (HIGH) -->
    <a href="https://wa.me/18001234567" class="floating-contact" aria-label="Escríbenos por WhatsApp" target="_blank" rel="noopener">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15c-1.52 0-3.01-.41-4.3-1.18l-.31-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.35c0-4.54 3.7-8.24 8.24-8.24s8.24 3.7 8.24 8.24-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.68-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43-.14-.01-.31-.01-.48-.01s-.43.06-.66.31c-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z"/></svg>
    </a>

    <!-- #2: Cookie banner (CRITICAL) -->
    <div class="cookie-banner" id="cookie-banner">
      <p class="cookie-text">Usamos cookies para mejorar tu experiencia y analizar el tráfico. <a href="/legal/">Más información</a>.</p>
      <div class="cookie-buttons">
        <button class="cookie-btn cookie-accept" id="cookie-accept">Aceptar</button>
        <button class="cookie-btn cookie-decline" id="cookie-decline">Solo esenciales</button>
      </div>
    </div>

    <script>
      // Mobile menu toggle
      document.querySelector('.mobile-menu-btn')?.addEventListener('click', () => {
        document.querySelector('.nav-links')?.classList.toggle('open');
      });

      // Language toggle
      document.querySelectorAll('.lang-link').forEach(link => {
        link.addEventListener('click', (e) => {
          e.preventDefault();
          const lang = link.dataset.lang;
          if (!lang) return;
          document.cookie = `tpt_lang=${lang}; path=/; max-age=${365 * 24 * 60 * 60}`;
          window.location.reload();
        });
      });

      // Set active class based on current cookie
      const match = document.cookie.match(/tpt_lang=([^;]+)/);
      const currentLang = match?.[1] || 'es';
      document.querySelectorAll('.lang-link').forEach(link => {
        link.classList.toggle('active', link.dataset.lang === currentLang);
      });

      // === #2: Cookie banner logic ===
      (function() {
        const banner = document.getElementById('cookie-banner');
        if (!banner) return;
        const consent = localStorage.getItem('tpt_cookie_consent');
        if (!consent) {
          banner.style.display = 'flex';
        }
        document.getElementById('cookie-accept')?.addEventListener('click', () => {
          localStorage.setItem('tpt_cookie_consent', 'accepted');
          banner.style.display = 'none';
        });
        document.getElementById('cookie-decline')?.addEventListener('click', () => {
          localStorage.setItem('tpt_cookie_consent', 'declined');
          banner.style.display = 'none';
        });
      })();

      // === #4: Back-to-top button ===
      (function() {
        const btn = document.getElementById('back-to-top');
        if (!btn) return;
        window.addEventListener('scroll', () => {
          if (window.scrollY > 500) {
            btn.classList.add('visible');
          } else {
            btn.classList.remove('visible');
          }
        });
        btn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();

      // === #8: Scroll progress bar ===
      (function() {
        const bar = document.getElementById('scroll-progress');
        if (!bar) return;
        window.addEventListener('scroll', () => {
          const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
          const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
          const pct = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
          bar.style.width = pct + '%';
        });
      })();

      // === #14: UTM tracking capture ===
      (function() {
        const params = new URLSearchParams(window.location.search);
        const utmParams = {};
        ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach(key => {
          const val = params.get(key);
          if (val) utmParams[key] = val;
        });
        if (Object.keys(utmParams).length > 0) {
          sessionStorage.setItem('tpt_utm_params', JSON.stringify(utmParams));
        }
        // Append UTM params to form hidden fields if present
        const stored = sessionStorage.getItem('tpt_utm_params');
        if (stored) {
          try {
            const parsed = JSON.parse(stored);
            document.querySelectorAll('form').forEach(form => {
              Object.entries(parsed).forEach(([key, val]) => {
                const existing = form.querySelector(`input[name="${key}"]`);
                if (!existing) {
                  const hidden = document.createElement('input');
                  hidden.type = 'hidden';
                  hidden.name = key;
                  hidden.value = val;
                  form.appendChild(hidden);
                }
              });
            });
          } catch {}
        }
      })();

      // === #9: Copy-to-clipboard buttons ===
      (function() {
        // Add copy buttons to all <pre> blocks
        document.querySelectorAll('pre').forEach(pre => {
          if (pre.querySelector('.copy-btn')) return;
          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.setAttribute('aria-label', 'Copiar');
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
          btn.addEventListener('click', async () => {
            try {
              const text = pre.textContent;
              await navigator.clipboard.writeText(text);
              btn.innerHTML = '✓';
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
                btn.classList.remove('copied');
              }, 2000);
            } catch {}
          });
          pre.style.position = 'relative';
          pre.appendChild(btn);
        });
      })();

      // === #17: Confirmation modal utility ===
      window.tptConfirm = function(options) {
        return new Promise(function(resolve) {
          var overlay = document.createElement('div');
          overlay.className = 'confirm-modal-overlay';
          overlay.innerHTML =
            '<div class="confirm-modal">' +
            '<h3>' + (options.title || '¿Estás seguro?') + '</h3>' +
            '<p>' + (options.message || 'Esta acción no se puede deshacer.') + '</p>' +
            '<div class="confirm-modal-buttons">' +
            '<button class="btn btn-outline" data-action="cancel">' + (options.cancelText || 'Cancelar') + '</button>' +
            '<button class="btn btn-primary" data-action="confirm">' + (options.confirmText || 'Confirmar') + '</button>' +
            '</div></div>';
          document.body.appendChild(overlay);
          requestAnimationFrame(function() { overlay.classList.add('open'); });
          function close(result) {
            overlay.classList.remove('open');
            setTimeout(function() { overlay.remove(); }, 200);
            resolve(result);
          }
          overlay.querySelector('[data-action="confirm"]').addEventListener('click', function() { close(true); });
          overlay.querySelector('[data-action="cancel"]').addEventListener('click', function() { close(false); });
          overlay.addEventListener('click', function(e) { if (e.target === overlay) close(false); });
          document.addEventListener('keydown', function esc(e) {
            if (e.key === 'Escape') { close(false); document.removeEventListener('keydown', esc); }
          });
        });
      };

      // === #1: Dark mode toggle ===
      (function() {
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) return;
        var darkIcon = toggle.querySelector('.theme-icon-dark');
        var lightIcon = toggle.querySelector('.theme-icon-light');
        var stored = localStorage.getItem('tpt_theme');
        if (stored === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          darkIcon.style.display = 'none';
          lightIcon.style.display = '';
        }
        toggle.addEventListener('click', function() {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('tpt_theme', 'light');
            darkIcon.style.display = '';
            lightIcon.style.display = 'none';
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('tpt_theme', 'dark');
            darkIcon.style.display = 'none';
            lightIcon.style.display = '';
          }
        });
      })();

      // === #3: Site search ===
      (function() {
        var btn = document.getElementById('nav-search-btn');
        var dropdown = document.getElementById('nav-search-dropdown');
        var input = document.getElementById('nav-search-input');
        var results = document.getElementById('nav-search-results');
        if (!btn || !dropdown || !input || !results) return;
        var pages = [
          { title: '¿Qué es un trust?', url: '/que-es/', keywords: 'que es trust fideicomiso revocable' },
          { title: 'Cómo funciona', url: '/como-funciona/', keywords: 'como funciona proceso pasos' },
          { title: 'Blog', url: '/blog/', keywords: 'blog articulos guias' },
          { title: 'Preguntas frecuentes', url: '/preguntas-frecuentes/', keywords: 'faq preguntas frecuentes dudas' },
          { title: 'Tu evaluación gratuita', url: '/evaluacion/', keywords: 'evaluacion gratuita cuestionario test' },
          { title: 'Contacto', url: '/contacto/', keywords: 'contacto contacto email whatsapp' },
          { title: 'Aviso legal', url: '/legal/', keywords: 'legal aviso privacidad terminos' },
          { title: 'Testimonios', url: '/testimonios/', keywords: 'testimonios reseñas opiniones' },
          { title: '¿Qué es un trust revocable?', url: '/blog/que-es-trust-revocable/', keywords: 'trust revocable que es' },
          { title: 'Trust vs testamento', url: '/blog/trust-vs-testamento/', keywords: 'trust testamento diferencia' },
          { title: '¿Cuánto cuesta un fideicomiso?', url: '/blog/cuanto-cuesta-fideicomiso/', keywords: 'costo precio fideicomiso trust' },
          { title: 'Seguro de vida y trust', url: '/blog/seguro-vida-trust/', keywords: 'seguro vida trust proteccion' },
          { title: 'Cómo crear un trust online', url: '/blog/como-crear-trust-online/', keywords: 'crear trust online digital' },
          { title: 'Fideicomiso revocable vs irrevocable', url: '/blog/fideicomiso-revocable-vs-irrevocable/', keywords: 'revocable irrevocable diferencia' },
          { title: '¿Necesito un abogado para un trust?', url: '/blog/necesito-abogado-trust/', keywords: 'abogado trust necesario' },
          { title: '¿Qué es probate y cómo evitarlo?', url: '/blog/que-es-probate-como-evitarlo/', keywords: 'probate evitar sucesion' },
        ];
        btn.addEventListener('click', function() {
          dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
          if (dropdown.style.display === 'block') input.focus();
        });
        document.addEventListener('click', function(e) {
          if (!dropdown.contains(e.target) && !btn.contains(e.target)) dropdown.style.display = 'none';
        });
        input.addEventListener('input', function() {
          var q = input.value.toLowerCase().trim();
          if (!q) { results.innerHTML = ''; return; }
          var matches = pages.filter(function(p) {
            return p.title.toLowerCase().includes(q) || p.keywords.toLowerCase().includes(q);
          }).slice(0, 8);
          if (matches.length === 0) {
            results.innerHTML = '<p class="search-empty">Sin resultados. Intenta con otras palabras.</p>';
          } else {
            results.innerHTML = matches.map(function(p) {
              return '<a href="' + p.url + '" class="search-result-item">' + p.title + '</a>';
            }).join('');
          }
        });
      })();
    </script>
  </body>
</html>