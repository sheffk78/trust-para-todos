---
import BaseLayout from './BaseLayout.astro';

export interface RelatedArticle {
  slug: string;
  title: string;
  tag: string;
  image: string;
}

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  heroImage: string;
  heroAlt: string;
  date?: string;
  readTime?: string;
  jsonLd?: object[] | object;
  relatedArticles?: RelatedArticle[];
}

const {
  title,
  description,
  canonicalPath,
  ogImage,
  heroImage,
  heroAlt,
  date,
  readTime,
  jsonLd,
  relatedArticles = []
} = Astro.props;

const SITE_URL = 'https://trustparatodos.com';
const canonical = canonicalPath ?? Astro.url.pathname;
const articleUrl = new URL(canonical, SITE_URL).href;

// Article schema for SEO
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  image: `${SITE_URL}${heroImage}`,
  datePublished: date ?? '2026-08-14',
  author: {
    '@type': 'Organization',
    name: 'Trust Para Todos'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Trust Para Todos',
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/assets/logo-shield.svg`
    }
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl
  }
};

// Breadcrumb schema for SERP
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: articleUrl },
  ],
};

const allSchemas = [articleSchema, breadcrumbSchema];
if (jsonLd) {
  if (Array.isArray(jsonLd)) {
    allSchemas.push(...jsonLd);
  } else {
    allSchemas.push(jsonLd);
  }
}

const formattedDate = date
  ? new Date(date).toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonical}
  ogImage={ogImage}
  jsonLd={allSchemas}
>
  <!-- Reading progress bar -->
  <div class="reading-progress" id="readingProgress"></div>

  <!-- Sticky mobile CTA bar -->
  <div class="sticky-cta-bar" id="stickyCtaBar">
    <div class="sticky-cta-content">
      <div class="sticky-cta-text">
        <span class="sticky-cta-title">Protege a tu familia</span>
        <span class="sticky-cta-sub">Evaluación gratuita · 3 min</span>
      </div>
      <a href="/evaluacion" class="sticky-cta-btn">Empezar →</a>
    </div>
  </div>

  <article class="blog-article">
    <!-- Hero image with title overlay -->
    <div class="blog-hero">
      <img src={heroImage} alt={heroAlt} class="blog-hero-img" loading="eager" />
      <div class="blog-hero-overlay">
        <a href="/blog" class="blog-back-link">← Blog</a>
        <h1 class="blog-title">{title}</h1>
        {date && (
          <div class="blog-meta">
            <time datetime={date}>{formattedDate}</time>
            {readTime && <span class="blog-meta-sep">·</span>}
            {readTime && <span>{readTime}</span>}
          </div>
        )}
      </div>
    </div>

    <!-- Article body container -->
    <div class="blog-container">
      <p class="last-updated">Actualizado: {formattedDate || 'agosto 2026'}</p>

      <!-- Table of contents (auto-generated) -->
      <nav class="blog-toc" id="blog-toc">
        <p class="blog-toc-title">En esta guía</p>
        <ul class="blog-toc-list"></ul>
      </nav>

      <!-- Article body (slot) -->
      <div class="blog-body">
        <slot />
      </div>

      <!-- WhatsApp share + Print -->
      <div class="blog-share">
        <a id="whatsappShare" href="#" class="share-btn share-whatsapp" aria-label="Compartir en WhatsApp">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.149-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          <span>Compartir en WhatsApp</span>
        </a>
        <button class="share-btn share-print" onclick="window.print()" aria-label="Imprimir artículo">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
          </svg>
          <span>Imprimir</span>
        </button>
      </div>

      <!-- CTA at bottom -->
      <div class="blog-cta-box">
        <h3>¿Estás listo para proteger a tu familia?</h3>
        <p>Conoce si un trust es adecuado para ti con nuestra evaluación gratuita de 3 minutos. No hay compromiso y la información es confidencial.</p>
        <a href="/evaluacion" class="btn btn-primary btn-lg">Haz tu evaluación gratuita →</a>
        <p class="blog-cta-note">Costo del servicio completo: <strong>$997</strong> · Incluye documentos legales, notarización, EIN del trust y asesoría en español.</p>
      </div>

      <!-- Related articles -->
      {relatedArticles.length > 0 && (
        <div class="related-articles">
          <h2 class="related-title">Artículos relacionados</h2>
          <div class="related-grid">
            {relatedArticles.map((a) => (
              <a href={`/blog/${a.slug}`} class="related-card">
                <div class="related-card-image">
                  <img src={a.image} alt={a.title} loading="lazy" />
                </div>
                <div class="related-card-body">
                  <span class="related-card-tag">{a.tag}</span>
                  <h3>{a.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </article>

  <!-- Interactive scripts -->
  <script is:inline>
    (function() {
      // === Reading progress bar ===
      var bar = document.getElementById('readingProgress');
      var article = document.querySelector('.blog-body');
      if (bar && article) {
        window.addEventListener('scroll', function() {
          var rect = article.getBoundingClientRect();
          var start = rect.top + window.scrollY - 100;
          var end = start + rect.height;
          var scrolled = window.scrollY - start;
          var progress = Math.max(0, Math.min(100, (scrolled / (end - start)) * 100));
          bar.style.width = progress + '%';
        }, { passive: true });
      }

      // === Table of contents ===
      var body = document.querySelector('.blog-body');
      if (body) {
        var h2s = body.querySelectorAll('h2');
        var tocNav = document.getElementById('blog-toc');
        if (tocNav && h2s.length >= 3) {
          var tocList = tocNav.querySelector('.blog-toc-list');
          h2s.forEach(function(h2, i) {
            var id = 'section-' + i;
            h2.id = id;
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.href = '#' + id;
            a.textContent = h2.textContent;
            a.addEventListener('click', function(e) {
              e.preventDefault();
              h2.scrollIntoView({ behavior: 'smooth' });
            });
            li.appendChild(a);
            tocList.appendChild(li);
          });
        } else if (tocNav) {
          tocNav.style.display = 'none';
        }
      }

      // === FAQ accordion toggle ===
      document.querySelectorAll('.faq-item h3').forEach(function(h3) {
        h3.setAttribute('role', 'button');
        h3.setAttribute('tabindex', '0');
        h3.style.cursor = 'pointer';
        var toggle = function() { h3.parentElement.classList.toggle('open'); };
        h3.addEventListener('click', toggle);
        h3.addEventListener('keydown', function(e) { if (e.key === 'Enter') toggle(); });
      });

      // === WhatsApp share link ===
      var waLink = document.getElementById('whatsappShare');
      if (waLink) {
        waLink.href = 'https://wa.me/?text=' + encodeURIComponent(document.title + ' — ' + window.location.href);
      }

      // === Sticky mobile CTA bar ===
      var stickyBar = document.getElementById('stickyCtaBar');
      var bodyEl = document.querySelector('.blog-body');
      if (stickyBar && bodyEl) {
        window.addEventListener('scroll', function() {
          var rect = bodyEl.getBoundingClientRect();
          var halfway = rect.top + rect.height * 0.3;
          if (halfway < 100) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
        }, { passive: true });
      }
    })();
  </script>
</BaseLayout>

<style is:global>
  /* === Blog Article Styles === */
  .blog-article {
    padding: 0;
  }

  /* Reading progress bar */
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    background: var(--teal);
    width: 0;
    z-index: 9999;
    transition: width 0.1s;
  }

  .blog-hero {
    width: 100%;
    height: 420px;
    overflow: hidden;
    position: relative;
    margin-top: 0;
  }

  .blog-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .blog-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 60%;
    background: linear-gradient(to top, rgba(15,15,26,0.7) 0%, rgba(15,15,26,0.2) 60%, transparent 100%);
    pointer-events: none;
  }

  .blog-hero-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    max-width: 780px;
    margin: 0 auto;
    padding: 0 24px 32px;
  }

  .blog-hero-overlay .blog-back-link {
    color: rgba(255,255,255,0.85);
    margin-bottom: 12px;
  }

  .blog-hero-overlay .blog-back-link:hover {
    color: var(--white);
  }

  .blog-hero-overlay .blog-title {
    color: var(--white);
    font-size: 2rem;
    line-height: 1.15;
    margin-bottom: 10px;
    text-shadow: 0 2px 12px rgba(0,0,0,0.4);
  }

  .blog-hero-overlay .blog-meta {
    color: rgba(255,255,255,0.8);
  }

  .blog-hero-overlay .blog-meta-sep {
    color: rgba(255,255,255,0.5);
  }

  .blog-container {
    max-width: 780px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .blog-header {
    margin-bottom: 40px;
  }

  .blog-back-link {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--teal);
    text-decoration: none;
    margin-bottom: 16px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .blog-back-link:hover {
    color: var(--terracotta);
  }

  .blog-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.4rem;
    line-height: 1.15;
    color: var(--dark);
    margin-bottom: 12px;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .blog-meta-sep {
    color: var(--cream-dark);
  }

  /* Table of contents */
  .blog-toc {
    background: var(--cream);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    margin-bottom: 32px;
  }
  .blog-toc-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 12px;
  }
  .blog-toc-list { list-style: none; padding: 0; margin: 0; }
  .blog-toc-list li { margin-bottom: 6px; }
  .blog-toc-list a {
    font-size: 0.95rem;
    color: var(--teal);
    text-decoration: none;
    line-height: 1.5;
    transition: color 0.2s;
  }
  .blog-toc-list a:hover { color: var(--terracotta); }

  /* Blog body typography */
  .blog-body {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--text-body);
  }

  .blog-body h2 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.6rem;
    color: var(--dark);
    margin-top: 48px;
    margin-bottom: 16px;
    line-height: 1.2;
    scroll-margin-top: 80px;
  }

  .blog-body h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.3rem;
    color: var(--dark);
    margin-top: 32px;
    margin-bottom: 12px;
  }

  .blog-body p {
    margin-bottom: 20px;
  }

  .blog-body ul, .blog-body ol {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .blog-body li {
    margin-bottom: 8px;
    line-height: 1.7;
  }

  .blog-body strong {
    color: var(--dark);
    font-weight: 700;
  }

  .blog-body a {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-color: var(--terracotta);
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .blog-body a:hover {
    color: var(--terracotta);
  }

  /* Buttons inside blog body — must keep white text */
  .blog-body .btn,
  .blog-body .btn-primary,
  .blog-body a.btn,
  .blog-body a.btn-primary {
    color: var(--white) !important;
  }
  .blog-body .btn:hover,
  .blog-body a.btn:hover {
    color: var(--white) !important;
  }

  /* Inline images in articles */
  .blog-body .article-image {
    margin: 32px 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .blog-body .article-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .blog-body .article-image figcaption {
    font-size: 0.85rem;
    color: var(--text-muted);
    padding: 8px 0 0;
    text-align: center;
  }

  /* Tables in articles */
  .blog-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 28px 0;
    font-size: 0.95rem;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .blog-body table th {
    background: var(--teal);
    color: var(--white);
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    padding: 12px 16px;
    text-align: left;
    font-size: 0.9rem;
  }

  .blog-body table td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--cream-dark);
    background: var(--white);
  }

  .blog-body table tr:last-child td {
    border-bottom: none;
  }

  .blog-body table tr:nth-child(even) td {
    background: var(--cream);
  }

  /* Callout boxes */
  .blog-body .callout {
    background: var(--terracotta-light);
    border-left: 4px solid var(--terracotta);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 20px 24px;
    margin: 28px 0;
    font-size: 1rem;
  }

  .blog-body .callout strong {
    color: var(--terracotta-dark);
  }

  /* Key takeaways box */
  .blog-body .key-takeaways {
    background: var(--teal-light);
    border-radius: var(--radius-sm);
    padding: 20px 24px;
    margin-bottom: 32px;
    border-left: 4px solid var(--teal);
  }
  .blog-body .key-takeaways-title {
    font-weight: 700;
    color: var(--teal);
    margin-bottom: 8px;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .blog-body .key-takeaways ul { margin: 0; padding-left: 20px; }
  .blog-body .key-takeaways li { font-size: 0.95rem; margin-bottom: 6px; line-height: 1.5; }

  /* Inline CTA */
  .blog-body .inline-cta {
    margin: 32px 0;
    padding: 24px;
    background: var(--terracotta-light);
    border-radius: var(--radius-sm);
    text-align: center;
    border-left: 4px solid var(--terracotta);
  }
  .blog-body .inline-cta p { margin-bottom: 16px; font-weight: 600; color: var(--dark); }
  .blog-body .inline-cta .btn { white-space: nowrap; }

  /* FAQ section */
  .blog-body .faq-section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 2px solid var(--cream-dark);
  }

  .blog-body .faq-section h2 {
    margin-top: 0;
  }

  .blog-body .faq-item {
    margin-bottom: 20px;
    background: var(--white);
    border: 1px solid var(--cream-dark);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .blog-body .faq-item h3 {
    font-size: 1.1rem;
    color: var(--dark);
    margin-bottom: 0;
    font-family: 'DM Sans', sans-serif;
    font-weight: 700;
    cursor: pointer;
    position: relative;
    padding: 20px 24px;
    padding-right: 48px;
  }

  .blog-body .faq-item h3::after {
    content: '+';
    position: absolute;
    right: 24px;
    top: 18px;
    font-size: 1.3rem;
    color: var(--terracotta);
    transition: transform 0.2s;
    font-weight: 400;
  }

  .blog-body .faq-item.open h3::after {
    transform: rotate(45deg);
  }

  .blog-body .faq-item p {
    margin-bottom: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease, padding 0.3s ease;
    padding: 0 24px;
    color: var(--text-body);
    line-height: 1.7;
  }

  .blog-body .faq-item.open p {
    max-height: 500px;
    padding: 0 24px 20px;
  }

  /* CTA box at bottom */
  .blog-cta-box {
    margin-top: 56px;
    padding: 40px;
    background: var(--teal-light);
    border-radius: var(--radius);
    text-align: center;
  }

  .blog-cta-box h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.5rem;
    color: var(--teal);
    margin-bottom: 12px;
  }

  .blog-cta-box p {
    font-size: 1rem;
    color: var(--text-body);
    margin-bottom: 24px;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .blog-cta-note {
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* WhatsApp share */
  .blog-share {
    margin: 32px 0;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .share-whatsapp { background: #25D366; color: white; }
  .share-whatsapp:hover { opacity: 0.85; }
  .share-print { background: var(--cream-dark); color: var(--dark); border: none; cursor: pointer; font-family: 'DM Sans', sans-serif; }
  .share-print:hover { background: var(--teal); color: white; }

  /* Sticky mobile CTA bar */
  .sticky-cta-bar {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: var(--teal);
    padding: 12px 20px;
    z-index: 9998;
    transform: translateY(100%);
    transition: transform 0.3s;
    box-shadow: 0 -2px 12px rgba(0,0,0,0.15);
  }
  .sticky-cta-bar.visible { transform: translateY(0); }
  .sticky-cta-content { display: flex; align-items: center; justify-content: space-between; max-width: 600px; margin: 0 auto; }
  .sticky-cta-text { display: flex; flex-direction: column; }
  .sticky-cta-title { font-weight: 700; color: white; font-size: 0.95rem; }
  .sticky-cta-sub { font-size: 0.78rem; color: rgba(255,255,255,0.8); }
  .sticky-cta-btn { background: var(--terracotta); color: white; padding: 10px 20px; border-radius: var(--radius-sm); font-weight: 700; white-space: nowrap; text-decoration: none; font-family: 'DM Sans', sans-serif; }
  .sticky-cta-btn:hover { opacity: 0.9; }
  @media (min-width: 769px) {
    .sticky-cta-bar { display: none; }
  }

  /* Callout box variants */
  .blog-body .callout-warning {
    background: #fdf0ec;
    border-left: 4px solid var(--terracotta);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 20px 24px;
    margin: 28px 0;
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .blog-body .callout-warning strong { color: var(--terracotta-dark); }
  .blog-body .callout-warning .callout-icon {
    color: var(--terracotta);
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    margin-top: 2px;
  }

