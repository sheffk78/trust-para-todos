const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Puedo quitar a mi exesposo como beneficiario del trust?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Por lo general sí, y se hace con una enmienda al trust cuando el decreto de divorcio ya está firmado. La parte delicada no es el papel sino la comunidad de bienes. En estados como California, Texas o Arizona, tu exesposo puede conservar derechos sobre bienes comprados durante el matrimonio, así que primero revisa el decreto y alinea la enmienda con él."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué pasa con la casa que puse en el trust si me divorcio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El juez del divorcio decide cómo se reparte el interés de la propiedad y el trust refleja ese reparto cuando todo queda firme. El trust por sí solo no quita ni reparte derechos del inmueble en medio del proceso. Para cómo se escribe la casa y cómo sigue protegida, revisa la guía del fideicomiso para tu casa."
      }
    },
    {
      "@type": "Question",
      "name": "¿Quién hereda si no actualizo el trust después del divorcio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los beneficiarios escritos en los papeles, tal cual están. El divorcio no los edita y el registro del condado tampoco. Por eso muchos ex cónyuges siguen apareciendo en trusts viejos, nadie firmó la enmienda. La buena noticia es que actualizar el papel es rápido y tú controlas ese paso."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda actualizar un trust después de un divorcio?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lo antes posible. No existe una fecha límite escrita en la ley, así que no dejes el papel dormido. Una enmienda simple se firma en una tarde, y lo que tarda de verdad es alinear el decreto, la comunidad de bienes y, cuando aplica, la firma de las dos partes."
      }
    }
  ]
};
