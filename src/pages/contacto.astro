---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contáctanos en Español por WhatsApp" description="Contáctanos por WhatsApp, formulario o correo electrónico. Estamos aquí para ayudarte en español a proteger tu patrimonio y el futuro de tu familia." canonicalPath="/contacto/" ogImage="og-contacto.png">

  <section class="hero" style="padding: 60px 20px;">
    <h1>Contacto</h1>
    <p>Estamos aquí para ayudarte. En español, siempre.</p>
  </section>

  <section class="section">
    <div class="container" style="max-width: 600px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 40px;">
        <!-- TODO: Replace with real WhatsApp number -->
        <a href="https://wa.me/18001234567" class="btn btn-teal btn-lg" style="background: #25D366; width: 100%; max-width: 400px;">
          💬 Escríbenos por WhatsApp
        </a>
        <p style="margin-top: 8px; color: var(--gray);">Respuesta en menos de 1 hora en horario laboral</p>
      </div>

      <form action="/api/contact" method="POST" style="background: var(--white); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow);">
        <div class="form-group">
          <label for="name">Nombre completo</label>
          <input type="text" id="name" name="name" required />
        </div>
        <div class="form-group">
          <label for="email">Correo electrónico</label>
          <input type="email" id="email" name="email" required />
        </div>
        <div class="form-group">
          <label for="phone">Teléfono (opcional)</label>
          <input type="tel" id="phone" name="phone" />
        </div>
        <div class="form-group">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" required placeholder="¿En qué podemos ayudarte?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-lg" style="width: 100%;">Enviar mensaje</button>
      </form>

      <div style="text-align: center; margin-top: 32px; color: var(--gray);">
        <p>📧 <a href="mailto:soporte@trustparatodos.com">soporte@trustparatodos.com</a></p>
        <p>Horario: Lun-Vie 9:00 AM - 6:00 PM (hora del centro)</p>
      </div>

      <!-- Legacy Foundation Group partner section -->
      <div style="margin-top: 40px; padding: 28px; background: #faf9f7; border: 1.5px solid var(--cream-dark); border-radius: var(--radius);">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
          <div style="width: 48px; height: 48px; border-radius: 10px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: white;">
            <img src="/images/lfg-logo-square.png" alt="Legacy Foundation Group" style="width: 100%; height: 100%; object-fit: contain;" />
          </div>
          <div>
            <h3 style="margin: 0; font-size: 1rem; color: var(--dark); font-family: 'Playfair Display', Georgia, serif;">Legacy Foundation Group</h3>
            <p style="margin: 0; font-size: 0.8rem; color: var(--text-muted);">Seguro de vida — nuestro partner de confianza</p>
          </div>
        </div>
        <p style="font-size: 0.9rem; color: var(--text-body); margin-bottom: 16px;">Para consultas sobre seguro de vida, contacta directamente a Legacy Foundation Group:</p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap;">
          <a href="https://legacyfoundationgroup.net/book?ref=trustparatodos" target="_blank" rel="noopener" style="display: inline-block; padding: 10px 24px; background: var(--terracotta, #dd7054); color: white; border-radius: 100px; font-weight: 600; text-decoration: none; font-size: 0.85rem;">
            Agendar consulta gratuita →
          </a>
          <a href="tel:8445341677" style="display: inline-block; padding: 10px 24px; background: white; color: var(--terracotta, #dd7054); border: 1.5px solid var(--terracotta, #dd7054); border-radius: 100px; font-weight: 600; text-decoration: none; font-size: 0.85rem;">
            📞 (844) 534-1677
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>